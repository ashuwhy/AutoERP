{
    "manifest_version": 3,
    "name": "AutoERP",
    "description": "Fills your IIT Kharagpur ERP and CDC login up to the OTP, and your end-semester feedback forms.",
    "homepage_url": "https://github.com/ashuwhy/AutoERP",
    "version": "2.1.0",
    "permissions": [
        "scripting",
        "activeTab",
        "storage"
    ],
    "host_permissions": [
        "*://erp.iitkgp.ac.in/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://erp.iitkgp.ac.in/SSOAdministration/login.htm*"
            ],
            "js": [
                "js/login.js"
            ]
        }
    ],
    "action": {
        "default_popup": "main.html",
        "default_title": "AutoERP",
        "default_icon": {
            "16": "images/icon16.png",
            "32": "images/icon32.png"
        }
    },
    "icons": {
        "16": "images/icon16.png",
        "32": "images/icon32.png",
        "48": "images/icon48.png",
        "128": "images/icon128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "fonts/archivo.woff2",
                "css/theme.css",
                "images/wordmark.svg"
            ],
            "matches": [
                "*://erp.iitkgp.ac.in/*"
            ]
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "autoerp@ashuwhy.com",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        },
        "gecko_android": {
            "strict_min_version": "142.0"
        }
    }
}
