{
    "manifest_version": 3,
    "name": "AutoERP",
    "description": "Fills the end-semester feedback forms on IIT Kharagpur ERP. You type the captcha, AutoERP does the rest.",
    "homepage_url": "https://github.com/ashuwhy/AutoERP",
    "version": "2.0.3",
    "permissions": [
        "scripting",
        "activeTab"
    ],
    "host_permissions": [
        "*://erp.iitkgp.ac.in/*"
    ],
    "action": {
        "default_popup": "main.html",
        "default_title": "AutoERP",
        "default_icon": {
            "16": "images/icon16.png",
            "32": "images/icon32.png"
        }
    },
    "icons": {
        "16": "images/icon16.png",
        "32": "images/icon32.png",
        "48": "images/icon48.png",
        "128": "images/icon128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "fonts/archivo.woff2"
            ],
            "matches": [
                "*://erp.iitkgp.ac.in/*"
            ]
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "autoerp@ashuwhy.com",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        },
        "gecko_android": {
            "strict_min_version": "142.0"
        }
    }
}
