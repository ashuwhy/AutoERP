{
    "manifest_version": 3,
    "name": "AutoERP",
    "description": "Fills your end-semester feedback forms on IIT Kharagpur ERP. you type the captcha, i can handle the rest.",
    "homepage_url": "https://github.com/ashuwhy/AutoERP",
    "version": "2.0.4",
    "permissions": [
        "scripting",
        "activeTab"
    ],
    "host_permissions": [
        "*://erp.iitkgp.ac.in/*"
    ],
    "action": {
        "default_popup": "main.html",
        "default_title": "AutoERP",
        "default_icon": {
            "16": "images/icon16.png",
            "32": "images/icon32.png"
        }
    },
    "icons": {
        "16": "images/icon16.png",
        "32": "images/icon32.png",
        "48": "images/icon48.png",
        "128": "images/icon128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "fonts/archivo.woff2"
            ],
            "matches": [
                "*://erp.iitkgp.ac.in/*"
            ]
        }
    ]
}
